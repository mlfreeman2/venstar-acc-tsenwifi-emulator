#!/usr/bin/env bash
# Installs the test environment on Python >=3.14.2. The test harness brings
# Home Assistant 2026.4.4, matching requirements-dev.txt, and includes the
# `hass` CLI used by scripts/develop.
set -e
cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip
python3 -m pip install -r requirements-test.txt
